include ../_mixin/breadcrumb.pug
include ../_mixin/sidebar.pug
include ../_mixin/widgets.pug

- ignores = []
if (theme.quicklink.ignores)
    - ignores.push(theme.quicklink.ignores)

- var covers = _cover_index(page, 6)
- var fullCoverList = _cover_list()
- var enableFixedCover = theme.homeConfig?.fixedCover
- var enablePreload = theme.experiments?.coverConfig?.enablePreload
- var enableCover = theme.experiments?.coverConfig?.enableCover
- var backgroundPosition = theme.background?.position || '50% 0%'
- var backgroundOpacity = theme.background?.opacity || 0.9
- var backgroundStyle = theme.background?.url ? `background: url('${theme.background.url}') ${backgroundPosition} / cover;background-repeat:repeat-y;background-attachment:fixed;` : ''

doctype html
html(lang=page.language?page.language:config.language, style=theme.grayMode ? 'filter: grayscale(1);':'' )
    head
        != partial('_partials/head/head.pug', {}, {cache: true})
        if enablePreload && enableCover
            if enableFixedCover
                link(rel="preload" href=theme.homeConfig.fixedCover as="image" fetchpriority="high")
            else if Array.isArray(covers)
                each image in covers
                    link(rel="preload" href!=image.url as="image" fetchpriority="high")
            else
                link(rel="preload" href!=covers.url as="image" fetchpriority="high")

        != partial('_partials/head/head_com.pug')
        != shokax_inject('head')
        title
            block title
                != `${alternate?alternate + " = ":""}${title}${subtitle?" = "+subtitle:""}`
    body(itemscope itemtype="http://schema.org/WebPage")
        != partial('_partials/loading.pug', {}, {cache: true})
        div(id="container")
            header(id="header" itemscope itemtype="http://schema.org/WPHeader")
                div(class="inner")
                    div(id="brand")
                        div(class="pjax")
                            block header
                                a(href=config.root class="logo" rel="start")
                                    if alternate
                                        p(class="artboard")
                                            != alternate
                                    h1(itemprop="name headline" class="title")
                                        != title
                                if subtitle
                                    p(class="meta" itemprop="description")
                                        != `= ${subtitle} =`

                    != partial('_partials/header.pug', {}, {cache: true})
                    
                div(id="imgs" class="pjax")
                    if enableCover
                        if theme.homeConfig.gradient || enableFixedCover
                            //- cover不可用时用Bing随机图片代替
                            - var coverImage = theme.homeConfig?.fixedCover || "https://7ed.net/bing/api"
                            img(src=coverImage loading="eager" decoding="async" fetchpriority="high" alt=title)
                        else
                            if Array.isArray(covers)
                                ul(id="cover_ul")
                                    each image in covers
                                        li(class="item" style=`background: url('${image.url}') ${image.position} / cover;`)
                                div(id="cover_list" style="display:none")
                                    each image in fullCoverList
                                        div(data-cover-url=image.url data-cover-position=image.position)
                            else
                                img(src=covers.url loading="eager" decoding="async" fetchpriority="high" alt=title style=`object-fit:cover;object-position:${covers.position}`)
                div(id="waves")
                    svg(class="waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto")
                        defs
                            path(id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z")
                        g(class="parallax")
                            use(xlink:href="#gentle-wave" x="48" y="0")
                            use(xlink:href="#gentle-wave" x="48" y="3")
                            use(xlink:href="#gentle-wave" x="48" y="5")
                            use(xlink:href="#gentle-wave" x="48" y="7")
                div(id="angle")
                    a(href="#main")
                        i(class="ic i-angle-down")
            div(style="background: white; position: relative;")
                div(id="bg_div" style=`${backgroundStyle}`)
                div(id="bg_mask" style=`opacity:${backgroundOpacity}`)
                main
                    div(class="inner")
                        div(id="main" class="pjax")
                            block content
                        div(id="sidebar")
                            block sidebar
                                +sidebarRender
                        div(class="dimmer")
                    div(id="player")
                footer(id="footer")
                    div(class="inner")
                        div(class="widgets")
                            +WRender
                        != partial('_partials/footer.pug', {}, {cache: true})
        - var ccIcon = '<i class="ic i-creative-commons"></i>'
        - var ccText = theme.creative_commons.license.toUpperCase()
        - var audioValue
        if page.audio
            - audioValue = JSON.stringify(page.audio);

        else if page.audio === false
            - audioValue = JSON.stringify({});
        else
            - audioValue = "undefined"

        - var ccIcon = '<i class="ic i-creative-commons"></i>'
        - var ccText = theme.creative_commons.license.toUpperCase()
        script(data-config type="text/javascript").
            var LOCAL = {
                ispost: !{is_post()},
                path: `#{_permapath(page.path)}`,
                favicon: {
                    show: `#{__('favicon.show')}`,
                    hide: `#{__('favicon.hide')}`
                },
                search: {
                    placeholder: "!{__('search.placeholder')}",
                    empty: "!{__('search.empty')}",
                    stats: "!{__('search.stats')}"
                },
                nocopy: "!{!!page.nocopy}",
                copyright: `!{page.copyright !== false ? (page.nocopy === true ? __("tips.nocopy") : __("tips.copyright", ccIcon + ccText)) : undefined}`,
                copy_tex: #{!!page.math},
                katex: #{!!page.math},
                mermaid: #{!!page.mermaid},
                audio: !{audioValue},
                fancybox: #{page.fancybox !== false},
                nocopy: #{!!page.nocopy},
                outime: #{page.outime !== false},
                template: `!{__('outime.template')}`,
                quiz: {
                    choice: `#{__('quiz.choice')}`,
                    multiple: `#{__('quiz.multiple')}`,
                    true_false: `#{__('quiz.true_false')}`,
                    essay: `#{__('quiz.essay')}`,
                    gap_fill: `#{__('quiz.gap_fill')}`,
                    mistake: `#{__('quiz.mistake')}`
                },
                ignores: [
                    (uri) => uri.includes('#'),
                    (uri) => new RegExp(LOCAL.path + '$').test(uri),
                        !{JSON.stringify(ignores)}
                ]
            };

        != partial('_partials/third-party/baidu-analytics.pug', {}, {cache: true})
        != partial('_partials/third-party/clarity.pug', {}, {cache: true})
        != partial('_partials/third-party/google-analytics.pug', {}, {cache: true})

        != vendor_js('pace')
        != vendor_js('jquery')
        != vendor_js('fancybox')
        != vendor_js('justifiedGallery')

        if theme.polyfill.enable
            script(src=`https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?version=4.8.0&features=${theme.polyfill.features}` defer)

        != _js('siteInit.js')
        script(src="/live2d-web/live2d-web.js")

        script.
            window.addEventListener('DOMContentLoaded', function() {
                const imgCount = 6;
                const domCoverList = document.querySelector('#cover_list');
                const coverItems = [...domCoverList.children].map(el =>({url:el.dataset.coverUrl,position:el.dataset.coverPosition}));
                const shuffled = [...coverItems].sort(() => Math.random() - 0.5);//洗牌
                const randomitems = shuffled.slice(0, imgCount);
                const domCoverUL = document.querySelector('#cover_ul');
                domCoverUL.innerHTML = '';
                for (let i = 0; i < randomitems.length; i++){
                    const randomItem = randomitems[i];
                    const domLI = document.createElement('li');
                    domLI.classList.add('item');
                    domLI.style.background = `url('${randomItem.url}') ${randomItem.position} / cover`;
                    domCoverUL.appendChild(domLI);
                }
            })
        
        script.
            window.addEventListener('load', function() {
                const innerWidth = window.innerWidth || document.documentElement.clientWidth;
                const userAgent = navigator.userAgent.toLowerCase();
                const isMobileUA = /android|iphone|ipad|ipod|windows phone|iemobile|opera mini|mobile/i.test(userAgent);
                console.log('live2dLoad',`innerWidth=${innerWidth}`,`isMobileUA=${isMobileUA}`);
                if (innerWidth > 768 && !isMobileUA) {
                    initLive2d({
                        live2d_path: '/live2d-web/',
                        model_path: '/live2d-web/model/'
                    });
                }
            })

        != shokax_inject('bodyEnd')


